{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "apps/docs#build": {
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "AUTH_TEST_DATABASE_URL",
        "RUN_IDENTITY_DATABASE_TESTS",
        "AUTH_CODE_HASH_SECRET",
        "AUTH_STATE_SECRET",
        "AUTH_RATE_LIMIT_SECRET"
      ]
    }
  }
}
