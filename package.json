{
  "name": "vyasen",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo build",
    "db:migrate": "pnpm --filter @vyasen/database migrate",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:check": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.2"
  }
}
